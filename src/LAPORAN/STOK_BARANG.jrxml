	<queryString language="SQL">
		<![CDATA[SELECT
     barang.`id_barang` AS barang_id_barang,
     barang.`nama_barang` AS barang_nama_barang,
     barang.`kategori` AS barang_kategori,
     barang.`jumlah` AS barang_jumlah
FROM
     `barang` barang;]]>
